# OS
.DS_Store
Thumbs.db

# IDEs / editors
.idea/
.vscode/
*.iml

# PHP / Composer (Medoo is provided by SwiftyEdit core, not bundled here)
/vendor/

# Runtime database (created on first install; /data/ itself must stay
# so PDO has a directory to write former.sqlite3 into)
/data/*.sqlite3
/data/*.sqlite

# User-uploaded form files (created at runtime by the installer/writer)
/uploads/*
!/uploads/.gitkeep

# Per-site custom template sets (betreiber-owned, not plugin source - see
# data/themes/README.md). Keep the folder + its own docs tracked, not the
# sets a specific installation drops in.
/data/themes/*
!/data/themes/.gitkeep
!/data/themes/README.md

# Release build artifacts (attach to GitHub Releases instead of committing)
/*.zip

# Logs
*.log
